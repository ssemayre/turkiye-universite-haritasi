* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  margin: 0;
}

body {
  font-family:
    Inter,
    "Segoe UI",
    Arial,
    sans-serif;

  background: #f4f6fb;
  color: #172033;
}

button,
input,
select {
  font-family: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: default;
  opacity: 0.35;
}

.app {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* HEADER */

.header {
  position: relative;
  min-height: 82px;

  padding: 14px 22px;

  display: flex;
  align-items: center;

  gap: 18px;

  background: rgba(255, 255, 255, 0.97);

  border-bottom: 1px solid #e7eaf0;

  box-shadow:
    0 2px 12px rgba(20, 31, 56, 0.06);

  z-index: 5000;
}

.logo-area {
  min-width: 270px;
}

.logo-area h1 {
  margin: 0;

  font-size: 22px;

  font-weight: 800;

  letter-spacing: -0.4px;
}

.logo-area p {
  margin: 5px 0 0;

  color: #7b8497;

  font-size: 12px;
}

/* SEARCH */

.search-area {
  position: relative;

  flex: 1;

  max-width: 600px;

  z-index: 7000;
}

.search-area > input {
  width: 100%;

  height: 46px;

  padding: 0 17px;

  border: 1px solid #e1e5ec;

  border-radius: 12px;

  outline: none;

  background: #f7f8fb;

  color: #172033;

  font-size: 14px;
}

.search-area > input:focus {
  background: white;

  border-color: #7180e8;

  box-shadow:
    0 0 0 4px rgba(113, 128, 232, 0.1);
}

.search-results {
  position: absolute;

  top: calc(100% + 8px);

  left: 0;
  right: 0;

  max-height: 520px;

  overflow-y: auto;

  background: white;

  border: 1px solid #e4e7ee;

  border-radius: 13px;

  box-shadow:
    0 16px 40px rgba(20, 31, 56, 0.16);

  z-index: 9000;
}

.search-result {
  width: 100%;

  padding: 13px 15px;

  border: 0;

  border-bottom: 1px solid #f0f1f4;

  background: white;

  color: #172033;

  text-align: left;
}

.search-result:hover {
  background: #f7f8fc;
}

.search-result strong {
  display: block;

  margin-top: 3px;

  font-size: 13px;
}

.search-result span {
  display: block;

  margin-top: 4px;

  color: #687285;

  font-size: 11px;
}

.search-result small {
  display: block;

  margin-top: 4px;

  color: #8b94a4;

  font-size: 10px;
}

.result-type {
  margin-top: 0 !important;

  color: #6671d6 !important;

  font-size: 9px !important;

  font-weight: 800;

  letter-spacing: 1px;
}

.program-search-result {
  display: flex;

  align-items: center;

  padding: 0;
}

.search-result-main {
  flex: 1;

  padding: 13px 15px;

  border: 0;

  background: transparent;

  text-align: left;

  color: #172033;
}

.quick-add-button {
  flex: 0 0 36px;

  width: 36px;

  height: 36px;

  margin-right: 10px;

  border: 0;

  border-radius: 10px;

  background: #eef0ff;

  color: #5966cf;

  font-size: 20px;
}

.quick-add-button.added {
  background: #e6f7ed;

  color: #159257;
}

.search-loading {
  position: absolute;

  top: calc(100% + 8px);

  left: 0;
  right: 0;

  padding: 13px 15px;

  background: white;

  border: 1px solid #e4e7ee;

  border-radius: 11px;

  box-shadow:
    0 12px 30px rgba(20, 31, 56, 0.12);

  color: #6d7687;

  font-size: 12px;

  z-index: 9000;
}

.no-result {
  padding: 20px;

  text-align: center;

  color: #80899a;

  font-size: 12px;
}

/* HEADER BUTTONS */

.header-actions {
  display: flex;

  align-items: center;

  gap: 7px;

  margin-left: auto;
}

.fit-button,
.header-list-button,
.filter-button {
  height: 42px;

  padding: 0 12px;

  border: 1px solid #e0e4eb;

  border-radius: 10px;

  background: white;

  color: #30394a;

  font-size: 11px;

  font-weight: 700;

  white-space: nowrap;
}

.fit-button:hover,
.header-list-button:hover,
.filter-button:hover {
  background: #f7f8fb;
}

.header-list-button span {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-width: 20px;

  height: 20px;

  margin-left: 6px;

  border-radius: 7px;

  background: #eef0ff;

  color: #5f6bd5;

  font-size: 10px;
}

.filter-count {
  display: inline-flex;

  align-items: center;

  justify-content: center;

  min-width: 20px;

  height: 20px;

  margin-left: 6px;

  border-radius: 7px;

  background: #eef0ff;

  color: #5f6bd5;

  font-size: 10px;
}

/* MAP */

.map-area {
  position: relative;

  flex: 1;

  min-height: 0;
}

.map {
  width: 100%;
  height: 100%;
}

/* TOOLTIP */

.university-tooltip {
  display: block;

  max-width: 260px;

  color: #1f2937;

  font-size: 11px;

  font-weight: 700;

  line-height: 1.3;

  white-space: normal;
}

/* POPUP */

.popup {
  min-width: 255px;

  color: #172033;
}

.popup h2 {
  margin: 0 0 10px;

  font-size: 17px;

  line-height: 1.25;
}

.popup p {
  margin: 7px 0;

  color: #667085;

  font-size: 12px;
}

.open-university-button {
  width: 100%;

  margin-top: 10px;

  padding: 10px 13px;

  border: 0;

  border-radius: 9px;

  background: #1f2a44;

  color: white;

  font-size: 12px;

  font-weight: 700;
}

/* FILTER PANEL */

.filter-panel,
.fit-panel {
  position: fixed;

  top: 98px;

  right: 20px;

  width: 330px;

  max-height: calc(100vh - 120px);

  overflow-y: auto;

  padding: 20px;

  border: 1px solid #e5e8ee;

  border-radius: 15px;

  background: rgba(255, 255, 255, 0.98);

  box-shadow:
    0 18px 45px rgba(20, 31, 56, 0.16);

  z-index: 8500;
}

.fit-panel {
  width: 390px;
}

.filter-header,
.fit-panel-header {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  margin-bottom: 16px;

  padding-right: 35px;
}

.filter-header h2,
.fit-panel-header h2 {
  margin: 0;

  font-size: 18px;
}

.filter-panel label,
.fit-panel label {
  display: block;

  margin: 13px 0 6px;

  color: #495468;

  font-size: 11px;

  font-weight: 800;
}

.filter-panel select,
.rank-input,
.fit-panel select,
.fit-rank-input {
  width: 100%;

  height: 40px;

  padding: 0 11px;

  border: 1px solid #e0e4eb;

  border-radius: 9px;

  outline: none;

  background: #fafbfc;

  color: #30394a;

  font-size: 12px;
}

.fit-description {
  margin: 0 0 10px;

  color: #737d8f;

  font-size: 11px;

  line-height: 1.5;
}

.fit-summary {
  display: flex;

  flex-direction: column;

  gap: 3px;

  margin-top: 12px;

  padding: 13px;

  border-radius: 10px;

  background: #f2f4ff;

  color: #5966cf;

  font-size: 11px;
}

.fit-summary strong {
  font-size: 20px;
}

.fit-result-count {
  display: flex;

  flex-direction: column;

  gap: 3px;

  margin-top: 10px;

  padding: 13px;

  border-radius: 10px;

  background: #eaf8f0;

  color: #188551;
}

.fit-result-count strong {
  font-size: 20px;
}

.fit-result-count span {
  font-size: 10px;
}

.fit-load-button {
  width: 100%;

  margin-top: 12px;

  height: 40px;

  border: 0;

  border-radius: 9px;

  background: #1f2a44;

  color: white;

  font-size: 11px;

  font-weight: 700;
}

.strategy-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-top: 14px;
}

.strategy-count {
  padding: 10px 7px;
  border-radius: 10px;
  text-align: center;
}

.strategy-count strong,
.strategy-count span {
  display: block;
}

.strategy-count strong {
  font-size: 19px;
}

.strategy-count span {
  margin-top: 2px;
  font-size: 10px;
  font-weight: 700;
}

.strategy-count.risky {
  background: #fff0f0;
  color: #bf4b4b;
}

.strategy-count.balanced {
  background: #fff8e8;
  color: #a26c16;
}

.strategy-count.safe {
  background: #eaf8f0;
  color: #188551;
}

.strategy-warnings {
  margin-top: 11px;
}

.strategy-warnings p {
  margin: 5px 0;
  padding: 8px 10px;
  border-radius: 8px;
  background: #f6f7fa;
  color: #687387;
  font-size: 10px;
  line-height: 1.4;
}

.strategy-program-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 12px;
}

.strategy-program-row {
  display: grid;
  grid-template-columns: 22px minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;
  padding: 9px;
  border: 1px solid #e7eaf0;
  border-radius: 9px;
}

.strategy-program-row > span {
  color: #6875d7;
  font-size: 11px;
  font-weight: 800;
}

.strategy-program-row strong,
.strategy-program-row small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.strategy-program-row strong {
  color: #30394b;
  font-size: 10px;
}

.strategy-program-row small {
  margin-top: 3px;
  color: #7b8597;
  font-size: 9px;
}

.strategy-tag {
  padding: 5px 7px;
  border-radius: 999px;
  font-size: 9px;
  font-style: normal;
  font-weight: 800;
  white-space: nowrap;
}

.strategy-tag.risky {
  background: #fff0f0;
  color: #bf4b4b;
}

.strategy-tag.balanced {
  background: #fff8e8;
  color: #a26c16;
}

.strategy-tag.safe {
  background: #eaf8f0;
  color: #188551;
}

.strategy-tag.unknown {
  background: #eef0f4;
  color: #738096;
}

.rank-info {
  margin-top: 9px;

  padding: 10px;

  border-radius: 9px;

  background: #f5f6fa;

  color: #798294;

  font-size: 10px;

  line-height: 1.45;
}

.filter-actions {
  margin-top: 17px;
}

.reset-filter {
  width: 100%;

  height: 40px;

  border: 0;

  border-radius: 9px;

  background: #eef0f4;

  color: #596273;

  font-size: 11px;

  font-weight: 700;
}

/* CLOSE */

.close-button {
  position: absolute;

  top: 12px;

  right: 12px;

  width: 32px;
  height: 32px;

  border: 0;

  border-radius: 9px;

  background: #f3f4f7;

  color: #687285;

  font-size: 16px;

  z-index: 2;
}

/* UNIVERSITY PANEL */

.university-panel {
  position: fixed;

  top: 101px;

  right: 20px;

  width: 430px;

  height: calc(100vh - 121px);

  max-width: calc(100vw - 40px);

  padding: 22px;

  border: 1px solid #e5e8ee;

  border-radius: 17px;

  background: rgba(255, 255, 255, 0.985);

  box-shadow:
    0 20px 50px rgba(20, 31, 56, 0.18);

  z-index: 8200;

  overflow: hidden;

  display: flex;

  flex-direction: column;
}

.university-panel-header {
  padding: 3px 38px 0 2px;
}

.university-panel-header h2 {
  margin: 7px 0;

  font-size: 22px;

  line-height: 1.2;
}

.university-panel-header p {
  margin: 0;

  color: #768094;

  font-size: 12px;
}

.detail-label {
  color: #6671d6;

  font-size: 9px;

  font-weight: 900;

  letter-spacing: 1.4px;
}

.university-stats {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 9px;

  margin: 18px 0;
}

.university-stat {
  padding: 13px;

  border: 1px solid #eaecf1;

  border-radius: 11px;

  background: #f8f9fb;
}

.university-stat strong {
  display: block;

  font-size: 20px;
}

.university-stat span {
  display: block;

  margin-top: 4px;

  color: #828b9c;

  font-size: 10px;
}

.university-program-header {
  display: flex;

  align-items: center;

  justify-content: space-between;

  margin-bottom: 9px;
}

.university-program-header h3 {
  margin: 0;

  font-size: 15px;
}

.university-program-header span {
  min-width: 25px;

  padding: 4px 7px;

  border-radius: 7px;

  background: #eef0ff;

  color: #5966cf;

  text-align: center;

  font-size: 10px;

  font-weight: 800;
}

.university-program-search {
  width: 100%;

  height: 40px;

  padding: 0 12px;

  margin-bottom: 10px;

  border: 1px solid #e1e4ea;

  border-radius: 9px;

  outline: none;

  background: #fafbfc;

  font-size: 12px;
}

.university-program-list {
  flex: 1;

  min-height: 0;

  overflow-y: auto;

  padding-right: 4px;

  display: flex;

  flex-direction: column;

  gap: 7px;
}

/* PROGRAM CARDS */

.university-program-item {
  display: flex !important;

  flex-direction: row !important;

  width: 100% !important;

  min-height: 72px !important;

  height: auto !important;

  padding: 0 !important;

  flex-shrink: 0 !important;

  overflow: hidden !important;

  border: 1px solid #e2e5eb !important;

  border-radius: 10px !important;

  background: white !important;
}

.university-program-main {
  flex: 1 1 auto !important;

  min-width: 0 !important;

  min-height: 70px !important;

  padding: 11px 12px !important;

  border: 0 !important;

  background: white !important;

  color: #172033 !important;

  text-align: left !important;

  display: flex !important;

  flex-direction: column !important;

  justify-content: center !important;

  gap: 3px !important;
}

.university-program-main:hover {
  background: #f8f9fc !important;
}

.university-program-main strong {
  display: block !important;

  color: #20293b !important;

  font-size: 12px !important;

  line-height: 1.3 !important;
}

.university-program-main span {
  display: block !important;

  color: #697487 !important;

  font-size: 10px !important;
}

.university-program-main small {
  display: block !important;

  color: #8a93a3 !important;

  font-size: 10px !important;
}

.program-add-button {
  flex: 0 0 46px !important;

  width: 46px !important;

  min-width: 46px !important;

  border: 0 !important;

  border-left: 1px solid #e5e7eb !important;

  background: #f7f8fb !important;

  color: #5966cf !important;

  font-size: 20px !important;
}

.program-add-button.added {
  background: #e7f7ed !important;

  color: #169456 !important;
}

/* PROGRAM DETAIL */

.program-detail {
  position: fixed;

  top: 101px;

  right: 20px;

  width: 410px;

  max-width: calc(100vw - 40px);

  max-height: calc(100vh - 121px);

  padding: 23px;

  overflow-y: auto;

  border: 1px solid #e5e8ee;

  border-radius: 17px;

  background: rgba(255, 255, 255, 0.985);

  box-shadow:
    0 20px 50px rgba(20, 31, 56, 0.18);

  z-index: 9000;
}

.program-detail h2 {
  margin: 7px 40px 6px 0;

  font-size: 22px;

  line-height: 1.2;
}

.detail-university {
  margin: 0;

  color: #768094;

  font-size: 12px;
}

.detail-tags {
  display: flex;

  flex-wrap: wrap;

  gap: 6px;

  margin: 15px 0;
}

.detail-tags span {
  padding: 7px 9px;

  border-radius: 20px;

  background: #f1f3f7;

  color: #586274;

  font-size: 10px;

  font-weight: 700;
}

.detail-actions {
  display: flex;

  gap: 7px;

  margin-bottom: 17px;
}

.primary-detail-button,
.secondary-detail-button {
  flex: 1;

  min-height: 40px;

  padding: 8px 10px;

  border-radius: 9px;

  font-size: 11px;

  font-weight: 700;
}

.primary-detail-button {
  border: 0;

  background: #1f2a44;

  color: white;
}

.primary-detail-button.added {
  background: #198f54;
}

.secondary-detail-button {
  border: 1px solid #dfe3ea;

  background: white;

  color: #4d5768;
}

.secondary-detail-button.selected {
  background: #eef0ff;

  color: #5966cf;
}

.detail-section {
  margin-top: 10px;
}

.detail-section h3 {
  margin: 0 0 9px;

  font-size: 14px;
}

.detail-row {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  gap: 15px;

  padding: 10px 0;

  border-bottom: 1px solid #eef0f3;

  font-size: 11px;
}

.detail-row span {
  color: #7a8394;
}

.detail-row strong {
  max-width: 62%;

  text-align: right;

  line-height: 1.35;
}

.highlight-row {
  margin: 2px -8px;

  padding-left: 8px;
  padding-right: 8px;

  border-radius: 8px;

  background: #f1f3ff;
}

.highlight-row span,
.highlight-row strong {
  color: #5966cf;
}

/* LOADING */

.program-loading-box {
  display: flex;

  min-height: 220px;

  align-items: center;

  justify-content: center;

  flex-direction: column;

  color: #7f8899;

  font-size: 12px;
}

.loading-spinner {
  width: 28px;
  height: 28px;

  margin-bottom: 10px;

  border: 3px solid #e2e4ea;

  border-top-color: #6672d5;

  border-radius: 50%;

  animation:
    university-spin 0.8s linear infinite;
}

@keyframes university-spin {
  to {
    transform: rotate(360deg);
  }
}

/* PREFERENCE DRAWER */

.preference-drawer {
  position: fixed;

  top: 101px;

  right: 20px;

  width: 490px;

  max-width: calc(100vw - 40px);

  height: calc(100vh - 121px);

  padding: 22px;

  border: 1px solid #e5e8ee;

  border-radius: 17px;

  background: rgba(255, 255, 255, 0.985);

  box-shadow:
    0 20px 50px rgba(20, 31, 56, 0.18);

  z-index: 8700;

  display: flex;

  flex-direction: column;

  overflow: hidden;
}

.preference-header {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  padding-right: 35px;
}

.preference-header h2 {
  margin: 6px 0 0;

  font-size: 21px;
}

.preference-toolbar {
  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 10px;

  margin: 15px 0;

  padding: 10px;

  border-radius: 9px;

  background: #f6f7fa;

  color: #7b8494;

  font-size: 10px;
}

.compare-open-button {
  padding: 8px 10px;

  border: 0;

  border-radius: 8px;

  background: #1f2a44;

  color: white;

  font-size: 10px;

  font-weight: 700;
}

.preference-list {
  flex: 1;

  min-height: 0;

  overflow-y: auto;

  display: flex;

  flex-direction: column;

  gap: 7px;
}

.preference-item {
  display: flex;

  /* 24 tercih olduğunda satırların esneyip incelmesini engeller. */
  flex: 0 0 auto;
  min-height: 76px;

  align-items: stretch;

  border: 1px solid #e2e5eb;

  border-radius: 10px;

  overflow: hidden;
}

.preference-order {
  flex: 0 0 40px;

  display: flex;

  align-items: center;

  justify-content: center;

  background: #f1f3ff;

  color: #5966cf;

  font-weight: 900;

  font-size: 12px;
}

.preference-main {
  flex: 1;

  padding: 11px;

  border: 0;

  background: white;

  color: #172033;

  text-align: left;

  display: flex;

  flex-direction: column;

  gap: 4px;
}

.preference-main:hover {
  background: #f8f9fc;
}

.preference-main strong {
  font-size: 12px;
}

.preference-main span {
  color: #697487;

  font-size: 10px;
}

.preference-main small {
  color: #8a93a3;

  font-size: 9px;
}

.preference-actions {
  display: flex;

  align-items: center;

  gap: 4px;

  padding: 6px;
}

.preference-item {
  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    opacity 160ms ease;
}

.preference-item:hover {
  box-shadow: 0 6px 18px rgba(31, 47, 83, 0.1);
}

.preference-item.dragging {
  opacity: 0.45;
  transform: scale(0.985);
}

.drag-handle {
  display: grid;
  place-items: center;
  flex: 0 0 23px;
  color: #9aa3b5;
  font-size: 19px;
  cursor: grab;
  user-select: none;
}

.drag-handle:active {
  cursor: grabbing;
}

.order-button,
.compare-mini,
.remove-mini {
  width: 31px;
  height: 31px;

  border: 0;

  border-radius: 7px;

  font-size: 12px;
}

.order-button {
  background: #f0f1f5;

  color: #596273;
}

.compare-mini {
  background: #f0f1f5;

  color: #5966cf;
}

.compare-mini.selected {
  background: #eef0ff;

  color: #5966cf;
}

.remove-mini {
  background: #f8e9e9;

  color: #a44949;
}

.clear-list-button {
  width: 100%;

  margin-top: 12px;

  height: 40px;

  border: 0;

  border-radius: 9px;

  background: #eef0f4;

  color: #596273;

  font-size: 11px;

  font-weight: 700;
}

.empty-preferences {
  padding: 55px 25px;

  text-align: center;

  color: #7f8899;
}

.empty-icon {
  font-size: 36px;

  margin-bottom: 8px;
}

.empty-preferences h3 {
  margin: 0 0 7px;

  color: #30394b;

  font-size: 15px;
}

.empty-preferences p {
  margin: 0;

  font-size: 11px;

  line-height: 1.5;
}

/* COMPARISON */

.modal-overlay {
  position: fixed;

  inset: 0;

  z-index: 10000;

  display: flex;

  align-items: center;

  justify-content: center;

  padding: 20px;

  background: rgba(18, 25, 42, 0.42);

  backdrop-filter: blur(3px);
}

.comparison-modal {
  width: 1080px;

  max-width: 100%;

  max-height: 90vh;

  padding: 23px;

  overflow: hidden;

  border-radius: 17px;

  background: white;

  box-shadow:
    0 24px 70px rgba(10, 18, 35, 0.28);
}

.comparison-header {
  display: flex;

  align-items: flex-start;

  justify-content: space-between;

  padding-right: 40px;

  margin-bottom: 17px;
}

.comparison-header h2 {
  margin: 7px 0 0;

  font-size: 22px;
}

.comparison-table-wrapper {
  max-height: calc(90vh - 130px);

  overflow: auto;
}

.comparison-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(150px, 1fr));
  gap: 10px;
  margin-bottom: 14px;
}

.comparison-summary > div {
  padding: 11px 12px;
  border: 1px solid #e4e7ed;
  border-radius: 10px;
  background: #f8f9fc;
}

.comparison-summary span,
.comparison-summary strong {
  display: block;
}

.comparison-summary span {
  color: #778197;
  font-size: 10px;
}

.comparison-summary strong {
  margin-top: 4px;
  color: #3f4cb5;
  font-size: 15px;
}

.comparison-table {
  width: 100%;

  min-width: 700px;

  border-collapse: collapse;
}

.comparison-table th,
.comparison-table td {
  padding: 12px;

  border: 1px solid #e4e7ed;

  vertical-align: top;

  font-size: 11px;

  line-height: 1.35;
}

.comparison-table th {
  background: #f7f8fb;

  color: #283247;
}

.comparison-table th:first-child,
.comparison-table td:first-child {
  width: 160px;

  background: #f7f8fb;

  font-weight: 800;
}

.comparison-table th strong {
  display: block;

  font-size: 11px;
}

.comparison-table th small {
  display: block;

  margin-top: 5px;

  color: #80899a;

  font-size: 9px;

  font-weight: normal;
}

.comparison-highlight td {
  background: #f1f3ff !important;

  color: #4f5cc8;

  font-weight: 800;
}

/* SCROLLBAR */

.university-program-list::-webkit-scrollbar,
.program-detail::-webkit-scrollbar,
.preference-list::-webkit-scrollbar,
.search-results::-webkit-scrollbar,
.comparison-table-wrapper::-webkit-scrollbar,
.filter-panel::-webkit-scrollbar,
.fit-panel::-webkit-scrollbar {
  width: 7px;
}

.university-program-list::-webkit-scrollbar-thumb,
.program-detail::-webkit-scrollbar-thumb,
.preference-list::-webkit-scrollbar-thumb,
.search-results::-webkit-scrollbar-thumb,
.comparison-table-wrapper::-webkit-scrollbar-thumb,
.filter-panel::-webkit-scrollbar-thumb,
.fit-panel::-webkit-scrollbar-thumb {
  background: #d5d9e1;

  border-radius: 20px;
}

/* MOBILE */

@media (max-width: 1000px) {
  .header {
    flex-wrap: wrap;

    padding: 12px 14px;
  }

  .logo-area {
    width: 100%;
  }

  .search-area {
    width: 100%;

    max-width: none;

    order: 3;
  }

  .header-actions {
    margin-left: auto;
  }

  .fit-panel,
  .filter-panel,
  .university-panel,
  .program-detail,
  .preference-drawer {
    top: 155px;

    right: 12px;

    left: 12px;

    width: auto;

    max-width: none;
  }

  .university-panel,
  .preference-drawer {
    height: calc(100vh - 168px);
  }

  .program-detail {
    max-height: calc(100vh - 168px);
  }
}

@media (max-width: 620px) {
  /* Mobil: üç ana kontrol ekranın altında sabit menü */
  .header-actions {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: calc(62px + env(safe-area-inset-bottom));
    margin: 0;
    padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 6px;
    background: rgba(255, 255, 255, 0.98);
    border-top: 1px solid #e2e6ee;
    box-shadow: 0 -8px 24px rgba(20, 31, 56, 0.12);
    z-index: 9500;
  }

  .header-actions button {
    min-width: 0;
    width: 100%;
    height: 50px;
    padding: 0 5px;
    border-radius: 9px;
    font-size: 9px;
  }

  .preference-item {
    align-items: flex-start;
  }

  .preference-main {
    min-width: 0;
  }

  .preference-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
    max-width: 78px;
  }

  .map-area {
    padding-bottom: calc(62px + env(safe-area-inset-bottom));
  }

  .comparison-modal {
    padding: 14px;
  }

  .comparison-summary {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   MOBİL ALT MENÜ - GELİŞMİŞ SÜRÜM
   ========================================================= */

@media (max-width: 620px) {
  .header-actions {
    left: 8px;
    right: 8px;
    bottom: calc(8px + env(safe-area-inset-bottom));
    width: auto;
    height: 64px;
    padding: 6px;
    gap: 5px;
    border: 1px solid #d9dfe8;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 10px 30px rgba(20, 31, 56, 0.18);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  .header-actions button {
    position: relative;
    height: 50px;
    padding: 0 4px;
    border: 0 !important;
    border-radius: 11px !important;
    background: transparent !important;
    color: #334056 !important;
    font-size: 9px !important;
    font-weight: 800 !important;
    box-shadow: none !important;
    white-space: normal;
    transition: background-color 160ms ease, color 160ms ease, transform 120ms ease;
  }

  .header-actions button:hover,
  .header-actions button:focus-visible {
    background: #f0f3f8 !important;
    color: #24314a !important;
    outline: none;
  }

  .header-actions button:active {
    transform: scale(0.97);
  }

  .header-list-button span,
  .filter-count {
    min-width: 19px;
    height: 19px;
    margin-left: 3px;
    border-radius: 7px;
    background: #e9edff !important;
    color: #4657c4 !important;
    font-size: 9px !important;
    font-weight: 900;
  }

  .map-area {
    padding-bottom: calc(80px + env(safe-area-inset-bottom));
  }

  .leaflet-control-zoom {
    margin-bottom: 6px !important;
  }

  /* Panel açıldığında alt menüye çarpmaması için alt boşluk */
  .fit-panel,
  .filter-panel,
  .university-panel,
  .program-detail,
  .preference-drawer {
    bottom: calc(78px + env(safe-area-inset-bottom)) !important;
  }

  /* Üniversite/program panelleri haritayı tamamen kaplamasın */
  .university-panel,
  .program-detail {
    max-height: 68vh !important;
  }

  .fit-panel,
  .filter-panel {
    max-height: 68vh !important;
  }

  /* Tercih listesi: başlık ve alt buton sabit, liste kayar */
  .preference-drawer {
    height: 68vh !important;
    max-height: 68vh !important;
    min-height: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    overflow: hidden !important;
  }

  .preference-header {
    flex: 0 0 auto;
  }

  .preference-toolbar {
    flex: 0 0 auto;
  }

  .preference-list {
    flex: 1 1 auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow-y: auto !important;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding-right: 3px;
    padding-bottom: 4px;
  }

  .clear-list-button {
    flex: 0 0 auto;
    margin-top: 10px;
    margin-bottom: 2px;
  }

  /* Kartlardaki aksiyonlar tek satırda kalsın */
  .preference-item {
    flex-shrink: 0 !important;
    align-items: stretch !important;
  }

  .preference-actions {
    flex-wrap: nowrap !important;
    max-width: none !important;
    flex: 0 0 auto;
    padding: 6px;
  }

  .preference-actions .order-button,
  .preference-actions .compare-mini,
  .preference-actions .remove-mini {
    flex: 0 0 30px;
  }

  /* Mobilde arama sonuçları daha rahat dokunulsun */
  .search-results {
    max-height: 48vh;
    border-radius: 12px;
  }

  .search-result,
  .search-result-main {
    min-height: 58px;
  }

  .quick-add-button {
    flex-basis: 38px;
    width: 38px;
    height: 38px;
  }
}

/* Çok dar telefonlar */
@media (max-width: 380px) {
  .header-actions {
    left: 6px;
    right: 6px;
    gap: 3px;
  }

  .header-actions button {
    font-size: 8px !important;
  }

  .header-list-button span,
  .filter-count {
    min-width: 17px;
    height: 17px;
    font-size: 8px !important;
  }
}

/* =========================================================
   MOBİL ALT MENÜ - PROFESYONEL NAVİGASYON
   ========================================================= */

@media (max-width: 620px) {
  .header-actions {
    height: 72px;
    bottom: calc(8px + env(safe-area-inset-bottom));
    padding: 5px;
    gap: 4px;
    border-radius: 18px;
    box-shadow:
      0 14px 34px rgba(20, 31, 56, 0.20),
      0 2px 8px rgba(20, 31, 56, 0.06);
  }

  .header-actions .mobile-nav-button {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    height: 60px;
    min-height: 60px;
    padding: 4px 3px;
    border-radius: 13px !important;
    overflow: visible;
  }

  .header-actions .mobile-nav-button::before {
    content: "";
    position: absolute;
    inset: 2px;
    border-radius: 12px;
    background: transparent;
    z-index: -1;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .header-actions .mobile-nav-button.is-active::before {
    background: #eef1ff;
    transform: scale(1);
  }

  .mobile-nav-icon {
    display: block;
    width: 26px;
    height: 26px;
    line-height: 26px;
    font-size: 18px;
    text-align: center;
    filter: saturate(0.92);
    transform: translateY(-1px);
  }

  .mobile-nav-label {
    display: block;
    max-width: 100%;
    overflow: hidden;
    color: #4a556b;
    font-size: 9px;
    font-weight: 800;
    line-height: 13px;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mobile-nav-button.is-active .mobile-nav-label {
    color: #3f4fb9;
  }

  .mobile-nav-count,
  .header-actions .filter-count.mobile-nav-filter-count {
    position: absolute;
    top: 4px;
    right: 18%;
    min-width: 18px;
    height: 18px;
    margin: 0;
    padding: 0 4px;
    border: 2px solid white;
    border-radius: 999px;
    background: #e9edff !important;
    color: #4657c4 !important;
    font-size: 8px !important;
    font-weight: 900;
    line-height: 14px;
    text-align: center;
    z-index: 2;
  }

  .header-actions .filter-count.mobile-nav-filter-count {
    background: #3f4fb9 !important;
    color: white !important;
  }

  .header-actions .mobile-nav-button:focus-visible {
    outline: 2px solid #7c88df;
    outline-offset: -2px;
  }

  .header-actions .mobile-nav-button:active {
    transform: scale(0.96);
  }

  /* Paneller alttaki navigasyonun üzerinde, ancak ekranın tamamını kaplamaz. */
  .fit-panel,
  .filter-panel,
  .university-panel,
  .program-detail,
  .preference-drawer {
    top: auto !important;
    bottom: calc(88px + env(safe-area-inset-bottom)) !important;
    max-height: min(68vh, 620px) !important;
    border-radius: 20px !important;
    box-shadow:
      0 18px 50px rgba(20, 31, 56, 0.22),
      0 2px 8px rgba(20, 31, 56, 0.06) !important;
  }

  .fit-panel,
  .filter-panel {
    padding: 18px !important;
  }

  .university-panel,
  .program-detail,
  .preference-drawer {
    height: min(68vh, 620px) !important;
  }

  .preference-drawer {
    padding: 18px !important;
  }

  .map-area {
    padding-bottom: calc(94px + env(safe-area-inset-bottom)) !important;
  }
}

@media (max-width: 380px) {
  .header-actions {
    height: 68px;
    bottom: calc(6px + env(safe-area-inset-bottom));
    left: 6px;
    right: 6px;
    border-radius: 17px;
  }

  .header-actions .mobile-nav-button {
    height: 56px;
    min-height: 56px;
  }

  .mobile-nav-icon {
    font-size: 17px;
  }

  .mobile-nav-label {
    font-size: 8px;
  }

  .map-area {
    padding-bottom: calc(88px + env(safe-area-inset-bottom)) !important;
  }
}
